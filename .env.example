# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# ====== App / Loja ======
# Em produção, a URL real — ela vai no sitemap, no canonical e nos e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_STORE_NAME=Aroma Haus
# E-mail que recebe avisos de novos pedidos pagos (lojista).
# Fallback dos avisos da loja. O painel (Configurações) tem precedência.
STORE_EMAIL=contato@aromahaus.com.br

# ====== Gateway de pagamento ======
# Qual gateway a loja usa: "mercadopago" ou "c6".
# Se vazio (ou sem credenciais), cai automaticamente no primeiro configurado.
# Nenhum configurado = pagamento via WhatsApp.
PAYMENT_GATEWAY=mercadopago

# ====== Mercado Pago ======
# Token de produção (ou de teste). Painel: Suas integrações → Credenciais.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Assinatura do webhook (Webhooks → sua URL → "Assinatura secreta").
MERCADOPAGO_WEBHOOK_SECRET=
# Credenciais do app OAuth. NÃO são usadas pelo código (autenticamos com o
# access token acima). Guardadas apenas para referência.
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=

# ====== C6 Bank (ver docs/C6.md) ======
# Credenciais do portal developers.c6bank.com.br (exige conta PJ + homologação).
C6_CLIENT_ID=
C6_CLIENT_SECRET=
# "sandbox" (padrão) ou "production".
C6_ENV=sandbox
# Opcional: sobrescreve a URL base (útil se a doc trouxer outro host).
C6_BASE_URL=
# Segredo do webhook. Enquanto vazio, a assinatura NÃO é validada.
C6_WEBHOOK_SECRET=
# Opcional: mTLS, só se o C6 exigir certificado cliente. PEM com \n escapado.
# Requer `npm i undici`.
C6_CLIENT_CERT=
C6_CLIENT_KEY=

# ====== Melhor Envio ======
# Sandbox: https://sandbox.melhorenvio.com.br  | Prod: https://www.melhorenvio.com.br
MELHORENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
# Token OAuth (Bearer). Gere em Configurações → Tokens no painel do Melhor Envio.
MELHORENVIO_TOKEN=
# CEP de origem (fallback). O endereço completo do remetente fica em Admin → Configurações → Frete.
MELHORENVIO_FROM_CEP=

# ====== E-mail (Resend) ======
# API key: https://resend.com/api-keys
RESEND_API_KEY=
# Remetente verificado no Resend (domínio precisa estar validado). Ex.: "Aroma Haus <pedidos@aromahaus.com.br>"
RESEND_FROM=
